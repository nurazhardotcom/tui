{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "tui — Context Budget",
    "output": "context.dataflow.html",
    "viewBox": [1080, 640],
    "quality_profile": "showcase",
    "views": [
      { "id": "budget-path", "label": "Budget path", "focus": ["prompt", "history", "prune"], "note": "Everything entering the model passes the 32k budget first." },
      { "id": "gate-path", "label": "Gate path", "focus": ["prune", "tools", "sanitize", "stream"], "note": "Tool output is gated, sanitized, then assembled." }
    ]
  },
  "stages": [
    { "label": "Input" },
    { "label": "Budget" },
    { "label": "Gate" },
    { "label": "Assemble" }
  ],
  "nodes": [
    { "id": "prompt", "type": "external", "label": "Operator prompt", "sublabel": "new input", "stage": 0, "row": 0 },
    { "id": "history", "type": "database", "label": "Session history", "sublabel": "old context", "stage": 0, "row": 2 },
    { "id": "prune", "type": "backend", "label": "prune-context", "sublabel": "32k tokens", "stage": 1, "row": 1, "tag": "4 chars/token" },
    { "id": "tools", "type": "security", "label": "allowed-tool?", "sublabel": "sh git cat ls", "stage": 2, "row": 0, "tag": "refuse root" },
    { "id": "sanitize", "type": "backend", "label": "sanitize-output", "sublabel": "strip ANSI", "stage": 2, "row": 2, "tag": "truncate" },
    { "id": "stream", "type": "messagebus", "label": "assemble", "sublabel": "SSE chunks", "stage": 3, "row": 1, "tag": "parallel" },
    { "id": "reply", "type": "external", "label": "Reply", "sublabel": "to operator", "stage": 3, "row": 3 }
  ],
  "flows": [
    { "id": "new-input", "from": "prompt", "to": "prune", "label": "new input", "classification": "unbounded", "variant": "default" },
    { "id": "old-context", "from": "history", "to": "prune", "label": "old context", "classification": "unbounded", "variant": "default" },
    { "id": "budgeted", "from": "prune", "to": "tools", "label": "budgeted", "classification": "bounded 32k", "variant": "emphasis" },
    { "id": "raw-output", "from": "prune", "to": "sanitize", "label": "raw output", "classification": "unbounded", "variant": "default" },
    { "id": "tool-result", "from": "tools", "to": "sanitize", "label": "tool result", "classification": "gated", "variant": "security", "labelAt": [530, 200] },
    { "id": "clean-chunks", "from": "sanitize", "to": "stream", "label": "clean chunks", "classification": "bounded", "variant": "emphasis" },
    { "id": "assembled", "from": "stream", "to": "reply", "label": "assembled", "classification": "reply", "variant": "default", "labelAt": [745, 314] }
  ],
  "cards": [
    { "dot": "emerald", "title": "Deterministic budget", "items": ["Token estimate is chars/4 — crude, predictable, testable", "Overflow truncates with a visible marker, never silently"] },
    { "dot": "rose", "title": "Gate before assemble", "items": ["Root and off-list tools are refused before execution", "ANSI escapes are stripped so output cannot repaint the terminal"] }
  ]
}
