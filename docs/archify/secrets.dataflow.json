{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "tui — Secrets vs Logs",
    "output": "secrets.dataflow.html",
    "viewBox": [1080, 640],
    "quality_profile": "showcase",
    "views": [
      { "id": "raw-path", "label": "Raw path", "focus": ["authfile", "resolver", "header", "backend"], "note": "Raw keys travel this path only — never branch it to storage." },
      { "id": "redacted-path", "label": "Redacted path", "focus": ["header", "redlog", "tripwire"], "note": "Everything observable carries ****last4 at most." }
    ]
  },
  "stages": [
    { "label": "Origins" },
    { "label": "Resolve" },
    { "label": "Use" },
    { "label": "Observe" }
  ],
  "nodes": [
    { "id": "authfile", "type": "security", "label": "auth.json", "sublabel": "OAuth file", "stage": 0, "row": 0, "tag": "0600 perms" },
    { "id": "envkey", "type": "security", "label": "OPENCODE_ZEN_KEY", "sublabel": "process env", "stage": 0, "row": 2, "tag": "fallback" },
    { "id": "resolver", "type": "security", "label": "resolve-credential", "sublabel": "expiry-aware", "stage": 1, "row": 1, "tag": "pure" },
    { "id": "header", "type": "security", "label": "Auth header", "sublabel": "Bearer raw", "stage": 2, "row": 0, "tag": "RAW" },
    { "id": "backend", "type": "backend", "label": "opencode + Zen", "sublabel": "uses raw key", "stage": 2, "row": 2 },
    { "id": "redlog", "type": "messagebus", "label": "App logs", "sublabel": "****last4 only", "stage": 3, "row": 0, "tag": "redacted" },
    { "id": "tripwire", "type": "security", "label": "CI grep", "sublabel": "gho_ tripwire", "stage": 3, "row": 2, "tag": "gate" }
  ],
  "flows": [
    { "id": "file-read", "from": "authfile", "to": "resolver", "label": "read file", "classification": "raw secret", "variant": "security" },
    { "id": "env-read", "from": "envkey", "to": "resolver", "label": "read env", "classification": "raw secret", "variant": "security" },
    { "id": "inject-bearer", "from": "resolver", "to": "header", "label": "inject Bearer", "classification": "raw secret", "variant": "security" },
    { "id": "proxy-use", "from": "header", "to": "backend", "label": "proxied call", "classification": "raw secret", "variant": "security", "labelAt": [530, 200] },
    { "id": "log-redacted", "from": "header", "to": "redlog", "label": "log ****last4", "classification": "redacted", "variant": "dashed" },
    { "id": "scan-logs", "from": "redlog", "to": "tripwire", "label": "pattern scan", "classification": "audit", "variant": "dashed", "labelAt": [745, 200] }
  ],
  "cards": [
    { "dot": "rose", "title": "Raw boundary", "items": ["Raw keys exist in memory between resolve and send only", "No raw key is written, cached, or returned to the client"] },
    { "dot": "emerald", "title": "Redacted boundary", "items": ["redact-key keeps last 4 chars for debugging", "CI fails the build on any gho_ token pattern"] }
  ]
}
